generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
  MEMBER
  CLIENT
}

enum TimeCategory {
  DEVELOPMENT
  DESIGN
  MEETING
  OPS
  RESEARCH
  OTHER
}

enum OrgType {
  CLIENT
  PARTNER
  FUNDER
  PRESS
  COMMUNITY
  ECOSYSTEM
}

enum InteractionType {
  CALL
  MEETING
  EMAIL
  EVENT
  PROPOSAL
  OTHER
}

enum ProposalStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

enum StoryStatus {
  BACKLOG
  SPRINT
  IN_PROGRESS
  REVIEW
  DONE
}

enum StoryType {
  CLIENT
  PARTNER
  INTERNAL
  OPEN_SOURCE
  INVESTIGATION
  GOVERNANCE
}

enum StoryRequestStatus {
  PENDING
  REVIEWED
  CONVERTED
  DECLINED
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String?
  role          Role      @default(MEMBER)
  contactId     String?   @unique
  createdAt     DateTime  @default(now())

  accounts       Account[]
  sessions       Session[]
  interactions   Interaction[]
  stories        Story[]
  timeEntries    TimeEntry[]
  storyRequests  StoryRequest[]
  contact        Contact?  @relation(fields: [contactId], references: [id])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Org {
  id        String   @id @default(cuid())
  name      String
  type      OrgType  @default(COMMUNITY)
  notes     String?
  website   String?
  createdAt DateTime @default(now())

  contacts      Contact[]
  stories       Story[]
  proposals     Proposal[]
  timeEntries   TimeEntry[]
  storyRequests StoryRequest[]
}

model Contact {
  id              String   @id @default(cuid())
  name            String
  orgId           String?
  role            String?
  email           String?
  phone           String?
  howWeMet        String?
  budgetSignal    String?
  decisionMaker   Boolean  @default(false)
  warmthScore     Int      @default(0)
  contextNote     String?
  createdAt       DateTime @default(now())
  lastTouchedAt   DateTime @default(now())

  org          Org?          @relation(fields: [orgId], references: [id])
  interactions Interaction[]
  stories      Story[]
  proposals    Proposal[]
  user         User?
}

model TimeEntry {
  id        String       @id @default(cuid())
  userId    String
  date      DateTime     @db.Date
  hours     Float
  category  TimeCategory @default(DEVELOPMENT)
  notes     String?
  orgId     String?
  storyId   String?
  createdAt DateTime     @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  org   Org?   @relation(fields: [orgId], references: [id])
  story Story? @relation(fields: [storyId], references: [id], onDelete: SetNull)
}

model Interaction {
  id          String          @id @default(cuid())
  contactId   String
  type        InteractionType @default(OTHER)
  notes       String?
  meaningful  Boolean         @default(false)
  loggedById  String?
  createdAt   DateTime        @default(now())

  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  loggedBy  User?   @relation(fields: [loggedById], references: [id])
}

model Sprint {
  id          String   @id @default(cuid())
  number      Int      @unique
  startDate   DateTime
  endDate     DateTime
  focus       String?
  totalPoints Int      @default(0)
  reflection  String?
  createdAt   DateTime @default(now())

  stories Story[]
}

model Story {
  id          String      @id @default(cuid())
  title       String
  points      Int         @default(1)
  status      StoryStatus @default(BACKLOG)
  type        StoryType   @default(INTERNAL)
  notes       String?
  blocked     Boolean     @default(false)
  flagged     Boolean     @default(false)
  sprintId    String?
  contactId   String?
  orgId       String?
  assignedToId String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  sprint        Sprint?       @relation(fields: [sprintId], references: [id])
  contact       Contact?      @relation(fields: [contactId], references: [id])
  org           Org?          @relation(fields: [orgId], references: [id])
  assignedTo    User?         @relation(fields: [assignedToId], references: [id])
  timeEntries   TimeEntry[]
  storyRequest  StoryRequest?
}

model StoryRequest {
  id            String             @id @default(cuid())
  title         String
  description   String?
  orgId         String?
  submittedById String?
  status        StoryRequestStatus @default(PENDING)
  convertedToId String?            @unique
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  org         Org?     @relation(fields: [orgId], references: [id])
  submittedBy User?    @relation(fields: [submittedById], references: [id])
  convertedTo Story?   @relation(fields: [convertedToId], references: [id])
}

model Proposal {
  id           String         @id @default(cuid())
  title        String
  orgId        String?
  contactId    String?
  status       ProposalStatus @default(DRAFT)
  projectDesc  String?
  coverLetter  String?
  termsNote    String?
  ratePerHour  Int            @default(150)
  expiresAt    DateTime?
  sentAt       DateTime?
  shareToken   String?        @unique
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  org      Org?               @relation(fields: [orgId], references: [id])
  contact  Contact?           @relation(fields: [contactId], references: [id])
  items    ProposalLineItem[]
}

model ProposalLineItem {
  id          String   @id @default(cuid())
  proposalId  String
  title       String
  description String?
  hours       Float    @default(0)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
}
